{
  "name": "projet-ts-js-3iw-2025-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:watch": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "start:web": "node scripts/serve-static.js",
    "dev:web": "concurrently \"npm:build:watch\" \"npm:start:web\"",
    "check": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
